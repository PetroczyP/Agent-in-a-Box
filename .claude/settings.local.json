{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:github.blog)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:pypi.org)",
      "WebFetch(domain:github.com)",
      "Bash(gh api:*)",
      "Bash(which uv:*)",
      "Bash(curl -LsSf https://astral.sh/uv/install.sh | sh)",
      "Bash(export PATH=\"$HOME/.local/bin:$PATH\" && uv tool install specify-cli --from git+https://github.com/github/spec-kit.git)",
      "Bash(export PATH=\"$HOME/.local/bin:$PATH\" && specify check)",
      "Bash(export PATH=\"$HOME/.local/bin:$PATH\" && specify init . --ai claude --force)"
    ]
  }
}
