+import os
+from dataclasses import dataclass
+
+VALID_LOG_LEVELS = {"DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"}
+
+
+def _parse_int_env(name: str, default: str) -> int:
+    raw = os.environ.get(name, default)
+    try:
+        return int(raw)
+    except ValueError:
+        raise ValueError(f"{name} must be an integer, got {raw!r}") from None
+
+
+@dataclass(frozen=True)
+class Settings:
+    db_host: str
+    db_port: int
+    db_name: str
+    log_level: str
+    max_connections: int
+
+    @classmethod
+    def from_env(cls) -> "Settings":
+        db_port = _parse_int_env("DB_PORT", "5432")
+        max_conn = _parse_int_env("MAX_CONNECTIONS", "10")
+        if db_port < 1 or db_port > 65535:
+            raise ValueError(f"DB_PORT must be 1-65535, got {db_port}")
+        if max_conn < 1:
+            raise ValueError(f"MAX_CONNECTIONS must be >= 1, got {max_conn}")
+        log_level = os.environ.get("LOG_LEVEL", "INFO").upper()
+        if log_level not in VALID_LOG_LEVELS:
+            raise ValueError(
+                f"LOG_LEVEL must be one of {sorted(VALID_LOG_LEVELS)}, got {log_level!r}"
+            )
+        return cls(
+            db_host=os.environ.get("DB_HOST", "localhost"),
+            db_port=db_port,
+            db_name=os.environ.get("DB_NAME", "app"),
+            log_level=log_level,
+            max_connections=max_conn,
+        )
